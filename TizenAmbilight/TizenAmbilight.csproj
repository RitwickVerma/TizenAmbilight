<Project Sdk="Tizen.NET.Sdk/1.1.9">

  <!-- Standalone real-frame ambilight. Tizen .NET, ZERO NuGet dependencies:
       the PNG decoder, the JSON writer and the capture P/Invoke are all first-party code. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>tizen90</TargetFramework>
    <RootNamespace>TizenAmbilight</RootNamespace>
    <AssemblyName>TizenAmbilight</AssemblyName>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>None</DebugType>
  </PropertyGroup>

  <!-- The Tizen SDK computes its default resource items with the Windows-only glob
       "res\**\*" (Tizen.NET.Sdk.Packaging.targets, TizenComputeTpkResourceFiles), which does
       not match on Linux, so the icon would silently never enter the TPK. Declare it explicitly. -->
  <ItemGroup>
    <TizenTpkFiles Include="res/TizenAmbilight.png" Condition="Exists('res/TizenAmbilight.png')">
      <TizenTpkSubDir>shared/res/</TizenTpkSubDir>
      <TizenTpkFileName>TizenAmbilight.png</TizenTpkFileName>
    </TizenTpkFiles>
  </ItemGroup>

  <!-- Signing is deliberately NOT configured here: credentials live in profiles.xml.
       This project must not embed passwords. Build only; sign/deploy is a separate step. -->

</Project>
